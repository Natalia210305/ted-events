generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String         @id @default(uuid())
  username         String         @unique
  password         String
  firstName        String
  lastName         String
  email            String         @unique
  phone            String?
  address          String?
  city             String?
  country          String?
  latitude         Float?
  longitude        Float?
  afm              String?
  role             Role           @default(ATTENDEE)
  status           UserStatus     @default(PENDING)
  createdAt        DateTime       @default(now())
  zipCode          String?
  bookings         Booking[]
  organizedEvents  Event[]        @relation("OrganizerEvents")
  viewedEvents     EventView[]
  receivedMessages Message[]      @relation("ReceivedMessages")
  sentMessages     Message[]      @relation("SentMessages")
  notifications    Notification[]
}

model Event {
  id            String          @id @default(uuid())
  title         String
  eventType     String
  venue         String
  address       String
  city          String
  latitude      Float?
  longitude     Float?
  startDateTime DateTime
  endDateTime   DateTime
  capacity      Int
  status        EventStatus     @default(DRAFT)
  description   String
  createdAt     DateTime        @default(now())
  organizerId   String
  country       String?
  bookings      Booking[]
  organizer     User            @relation("OrganizerEvents", fields: [organizerId], references: [id])
  categories    EventCategory[]
  photos        EventPhoto[]
  views         EventView[]
  messages      Message[]
  ticketTypes   TicketType[]
}

model EventView {
  id       String   @id @default(uuid())
  userId   String
  eventId  String
  viewedAt DateTime @default(now())
  event    Event    @relation(fields: [eventId], references: [id])
  user     User     @relation(fields: [userId], references: [id])
}

model EventCategory {
  id      String @id @default(uuid())
  name    String
  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

model TicketType {
  id        String    @id @default(uuid())
  name      String
  price     Float
  quantity  Int
  available Int
  eventId   String
  bookings  Booking[]
  event     Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

model Booking {
  id              String        @id @default(uuid())
  time            DateTime      @default(now())
  numberOfTickets Int
  totalCost       Float
  status          BookingStatus @default(PENDING)
  attendeeId      String
  eventId         String
  ticketTypeId    String
  attendee        User          @relation(fields: [attendeeId], references: [id])
  event           Event         @relation(fields: [eventId], references: [id])
  ticketType      TicketType    @relation(fields: [ticketTypeId], references: [id])
}

model EventPhoto {
  id      String @id @default(uuid())
  eventId String
  url     String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

model Message {
  id                String    @id @default(uuid())
  content           String
  sentAt            DateTime  @default(now())
  readAt            DateTime?
  senderId          String
  receiverId        String
  eventId           String?
  deletedByReceiver Boolean   @default(false)
  deletedBySender   Boolean   @default(false)
  event             Event?    @relation(fields: [eventId], references: [id])
  receiver          User      @relation("ReceivedMessages", fields: [receiverId], references: [id])
  sender            User      @relation("SentMessages", fields: [senderId], references: [id])
}

model Notification {
  id        String   @id @default(uuid())
  message   String
  type      String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum Role {
  ADMIN
  ORGANIZER
  ATTENDEE
}

enum UserStatus {
  PENDING
  APPROVED
  REJECTED
}

enum EventStatus {
  DRAFT
  PUBLISHED
  COMPLETED
  CANCELLED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
}
